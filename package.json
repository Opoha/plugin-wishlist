{
  "name": "@opoha/plugin-wishlist",
  "version": "1.0.0",
  "description": "Official Opoha wishlist plugin — add/remove/list saved products (Phase 4 D-02)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./database": {
      "types": "./dist/database.d.ts",
      "import": "./dist/database.js"
    }
  },
  "files": [
    "dist",
    "opoha.plugin.json"
  ],
  "opoha": {
    "id": "wishlist",
    "version": "1.0.0",
    "contractVersion": "0.1",
    "entry": "dist/index.js",
    "displayName": "Wishlist",
    "description": "Customer-scoped saved products list",
    "dependsOn": [],
    "required": false,
    "engines": {}
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@opoha/plugin-sdk": "file:../opoha-plugin-sdk",
    "reflect-metadata": "^0.2.2",
    "typeorm": "0.3.27",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opoha/typescript-config": "file:../opoha-devkit/packages/typescript-config",
    "@opoha/vitest-config": "file:../opoha-devkit/packages/vitest-config",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "packageManager": "pnpm@11.7.0"
}
